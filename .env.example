# Kopiere diese Datei nach .env und trage die Werte deines Supabase-Projekts ein
# (Supabase-Dashboard → Project Settings → API).
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
# Öffentliche Adresse der App (für den QR-Code und die Zugangsdaten-Nachricht). Leer = aktuelle Adresse im Browser.
VITE_PUBLIC_URL=
